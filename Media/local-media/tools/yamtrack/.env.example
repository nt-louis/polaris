# Yamtrack Security Keys
# Generate a secret key using: openssl rand -hex 32
YAMTRACK_SECRET=your_random_secure_yamtrack_secret_key

# PostgreSQL Settings
YAMTRACK_DB_NAME=yamtrack
YAMTRACK_DB_USER=yamtrack
YAMTRACK_DB_PASSWORD=your_random_secure_db_password

# Allowed Hosts (comma-separated list of public/local domains)
YAMTRACK_ALLOWED_HOSTS=yamtrack.example.com,localhost,127.0.0.1

# OpenID Connect (OIDC) PocketID Integration
# Configuration JSON for django-allauth providers. Replace secrets and client_id to match PocketID.
YAMTRACK_SOCIALACCOUNT_PROVIDERS={"openid_connect": {"APPS": [{"provider_id": "pocketid", "name": "PocketID", "client_id": "yamtrack", "secret": "your_pocketid_oidc_client_secret", "settings": {"server_url": "https://auth.example.com/.well-known/openid-configuration", "uid_field": "preferred_username"}}]}}

# Optional external integrations referenced by the Compose service.
TRAKT_API=your_trakt_client_id_here
TRAKT_API_SECRET=your_trakt_client_secret_here
SIMKL_ID=your_simkl_client_id_here
SIMKL_SECRET=your_simkl_client_secret_here
ANILIST_ID=your_anilist_client_id_here
ANILIST_SECRET=your_anilist_client_secret_here
STEAM_API_KEY=your_steam_api_key_here

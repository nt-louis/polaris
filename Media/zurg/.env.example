# Path to the base media directory on the host VPS
MEDIA_SHARE=/mnt/media

# User and Group ID for permissions
PUID=1000
GUID=1000

# Real-Debrid API Token (Retrieve from https://real-debrid.com/apitoken)
RD_API_KEY=your_real_debrid_api_token_here

# Torbox WebDAV Credentials
# Note: For TB_PASS, run 'docker run --rm rclone/rclone obscure YOUR_PASSWORD' and paste the output string.
TB_EMAIL=your_torbox_email_here
TB_PASS=your_obscured_torbox_password_here

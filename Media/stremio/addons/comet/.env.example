ADMIN_PASSWORD=your_admin_password_here
PUID=1001
PGID=1001
# --- GENERAL SETTINGS ---
TZ=America/New_York
# --- COMET CONFIGURATION ---
# The public URL where Comet will be accessible.
# If using Caddy/Proxy: https://comet.yourdomain.com
# If using Direct IP: http://192.168.1.XX:8000
PUBLIC_BASE_URL=https://example.com
# --- JACKETT CONFIGURATION ---
# Get this API Key from the Jackett Web UI (Top right corner) after first launch.
JACKETT_API_KEY=your_jackett_api_key_here
# --- POSTGRES DATABASE ---
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=your_postgres_db_here
# --- PERFORMANCE TUNING (Optional - defaults are sensible) ---
# Uncomment and adjust only if needed. Values shown are the defaults.
# FASTAPI_WORKERS=2
# INDEXER_MANAGER_TIMEOUT=12
# BACKGROUND_SCRAPER_ENABLED=True
# BACKGROUND_SCRAPER_CONCURRENT_WORKERS=2
# SCRAPE_JACKETT=both
# SCRAPE_TORRENTIO=both
# SCRAPE_ZILEAN=both

# Additional Compose-supported tuning variables. Leave the documented defaults
# unless the service workload requires a change.
FASTAPI_WORKERS=2
USE_GUNICORN=True
GUNICORN_PRELOAD_APP=True
EXECUTOR_MAX_WORKERS=2
HTTP_CLIENT_LIMIT=100
HTTP_CLIENT_LIMIT_PER_HOST=20
HTTP_CLIENT_TIMEOUT_TOTAL=30
INDEXER_MANAGER_TIMEOUT=12
INDEXER_MANAGER_WAIT_TIMEOUT=15
SCRAPE_JACKETT=both
JACKETT_URL=http://media-gateway-stremio-utilities-gluetun:9117
SCRAPE_TORRENTIO=both
SCRAPE_ZILEAN=both
TORRENT_CACHE_TTL=-1
LIVE_TORRENT_CACHE_TTL=86400
DEBRID_CACHE_TTL=86400
METADATA_CACHE_TTL=2592000
BACKGROUND_SCRAPER_ENABLED=True
BACKGROUND_SCRAPER_CONCURRENT_WORKERS=2
BACKGROUND_SCRAPER_INTERVAL=3600
BACKGROUND_SCRAPER_MAX_MOVIES_PER_RUN=150
BACKGROUND_SCRAPER_MAX_SERIES_PER_RUN=150
BACKGROUND_SCRAPER_ENABLE_DEMAND_PRIORITY=True

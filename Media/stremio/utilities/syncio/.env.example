# Syncio Configuration
# Generate a random 32-character base64 string for JWT_SECRET
# You can generate one using: openssl rand -base64 32
SYNCIO_JWT_SECRET=your_jwt_secret_here

# Generate a random 32-character hex string (16 bytes) for ENCRYPTION_KEY
# You can generate one using: openssl rand -hex 16
SYNCIO_ENCRYPTION_KEY=your_encryption_key_here

# Optional: Private Instance Authentication credentials
# If left empty, the instance will have no login screen (useful inside a secure Tailnet)
SYNCIO_PRIVATE_USERNAME=
SYNCIO_PRIVATE_PASSWORD=

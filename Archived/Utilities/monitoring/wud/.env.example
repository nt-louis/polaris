# WhatsUpDocker Configuration Template
TZ=America/New_York

# WhatsUpDocker Public URL (For OIDC Redirect/Callback verification)
# Example: https://wud.example.com
WUD_PUBLIC_URL=

# Discord Webhook Trigger (Standard Discord URL)
# Example: https://discord.com/api/webhooks/1234567890/abcde_fg-hij
WUD_DISCORD_WEBHOOK=

# Telegram Trigger (Raw Bot Token and Chat ID)
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
WUD_TELEGRAM_TOKEN=
# Example: 987654321 or -100123456789
WUD_TELEGRAM_CHATID=

# WhatsUpDocker UI OIDC Authentication
# Create an OAuth2 Provider in Authentik with callback URL:
# Redirect URI: https://wud.example.com/auth/oidc/authentik/cb
WUD_OIDC_CLIENT_ID=
WUD_OIDC_CLIENT_SECRET=
# Example Discovery URL: https://auth.example.com/application/o/whats-up-docker/.well-known/openid-configuration
WUD_OIDC_DISCOVERY=

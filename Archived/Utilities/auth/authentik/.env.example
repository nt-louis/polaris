# ==============================================================================
# Authentik Configuration Template
# ==============================================================================

# PostgreSQL Settings
PG_USER=authentik
PG_DB=authentik
PG_PASS=your_random_secure_postgresql_password

# Security Keys
# Generate a secret key using: openssl rand -hex 64
AUTHENTIK_SECRET_KEY=your_random_secure_authentik_secret_key

# ==============================================================================
# SMTP Email Settings (Notifications, Password Resets, Alerts)
# ==============================================================================
AUTHENTIK_EMAIL__HOST=localhost
AUTHENTIK_EMAIL__PORT=25
# SMTP Authentication (do NOT wrap values in quotes)
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
# STARTTLS (Explicit TLS) - Usually port 587 (USE_TLS=true, USE_SSL=false)
AUTHENTIK_EMAIL__USE_TLS=false
# Implicit SSL/TLS - Usually port 465 (USE_SSL=true, USE_TLS=false)
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
# Sender address (e.g., "authentik <sso@yourdomain.com>" or "sso@yourdomain.com")
AUTHENTIK_EMAIL__FROM=authentik@example.com

# Authentik LDAP Outpost Security Token (Copy from Authentik Outpost UI page)
AUTHENTIK_LDAP_TOKEN=your_authentik_ldap_outpost_token_here



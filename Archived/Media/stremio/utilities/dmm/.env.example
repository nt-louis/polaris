# Debrid Media Manager (DMM) Environment Configuration (VPS B)

# Database Setup
DMM_MYSQL_ROOT_PASSWORD="your_secure_mysql_root_password"
DMM_MYSQL_DATABASE="dmm"
DMM_MYSQL_USER="dmm"
DMM_MYSQL_PASSWORD="your_secure_db_user_password"

# NextAuth Configuration
# Set this to the public URL that routes to DMM, e.g. https://your-vps-b-tailscale-fqdn/dmm
DMM_NEXTAUTH_URL="https://your-vps-b-tailscale-fqdn/dmm"
# Generate a secure 32-character random string (e.g. using `openssl rand -base64 32`)
DMM_NEXTAUTH_SECRET="your_nextauth_secret_here"

# Real-Debrid OAuth Credentials (optional but recommended for user management)
REALDEBRID_CLIENT_ID="your_realdebrid_oauth_client_id"
REALDEBRID_CLIENT_SECRET="your_realdebrid_oauth_client_secret"

# MediaFusion Environment Variables (VPS B)

# Database Configuration
POSTGRES_USER="mediafusion"
POSTGRES_PASSWORD="your_secure_db_password"
POSTGRES_DB="mediafusion"

# Secret Key (generate a 16-character hex string, e.g. using `openssl rand -hex 16`)
MEDIAFUSION_SECRET_KEY="your_generated_secret_key"

# API Password (to access the admin/scheduler UI)
MEDIAFUSION_API_PASSWORD="your_secure_api_password"

# Host FQDN (your VPS B Tailscale FQDN or public domain)
MEDIAFUSION_HOST_URL="https://your-vps-b-tailscale-fqdn/mediafusion"

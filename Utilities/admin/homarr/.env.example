# Homarr Dashboard Configuration
# Add these variables to your decrypted .env file on the server.
# Generate a secure 64-character hex key using: openssl rand -hex 32
HOMARR_SECRET_KEY=generate_your_64_character_hex_key_here

# Single Sign-On / OIDC Configuration
# Generate a secure random string for Auth.js using: openssl rand -hex 32
AUTH_SECRET=generate_your_secure_auth_secret_here
HOMARR_URL=https://home.example.com

AUTH_PROVIDERS=oidc,credentials
AUTH_OIDC_ISSUER=https://auth.example.com
AUTH_OIDC_CLIENT_ID=homarr
AUTH_OIDC_CLIENT_SECRET=homarr_oidc_client_secret_from_pocketid
AUTH_OIDC_CLIENT_NAME=PocketID
AUTH_OIDC_AUTO_LOGIN=true
AUTH_OIDC_ENABLE_DANGEROUS_ACCOUNT_LINKING=false

# OIDC Group Mapping Configuration
AUTH_OIDC_GROUPS_ATTRIBUTE=groups
AUTH_OIDC_SCOPE_OVERWRITE=openid email profile groups

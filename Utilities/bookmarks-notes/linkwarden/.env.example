# Linkwarden Configuration
LINKWARDEN_NEXTAUTH_SECRET=secure_nextauth_secret_key_1234

# Base URL of your Linkwarden instance (e.g. https://linkwarden.example.com)
LINKWARDEN_URL=

# Authentik OIDC Settings
# Note: Set Redirect URI in Authentik to: ${LINKWARDEN_URL}/api/v1/auth/callback/authentik
LINKWARDEN_OIDC_CLIENT_ID=
LINKWARDEN_OIDC_CLIENT_SECRET=
# OIDC Issuer URL (e.g. https://auth.example.com/application/o/linkwarden - do not add a trailing slash!)
LINKWARDEN_OIDC_ISSUER=
LINKWARDEN_OIDC_DISPLAY_NAME=Authentik

# Security Toggles
# Set to 'false' to disable username/password login form (requires Authentik OIDC to be working first!)
LINKWARDEN_CREDENTIALS_ENABLED=true
# Set to 'true' to disable public registration
LINKWARDEN_DISABLE_REGISTRATION=false

# Database Configuration
LINKWARDEN_DB_USER=linkwarden
LINKWARDEN_DB_PASSWORD=your_db_password_here
LINKWARDEN_DB_NAME=linkwarden


# ==========================================
# NetBird Control Plane Configuration
# ==========================================

# NetBird Domain Name (public domain for the dashboard and APIs)
NETBIRD_DOMAIN=netbird.example.com

# Secure secret token for TURN and Relay auth (generate a long random password)
NETBIRD_RELAY_SECRET=generate-a-long-secure-random-secret-here

# Optional: NetBird internal DNS domain
NETBIRD_DNS_DOMAIN=netbird.selfhosted

# ==========================================
# OIDC Integration (PocketID)
# ==========================================

# Base URL of PocketID (as accessed by the user's browser, e.g. https://auth.example.com)
OIDC_ISSUER=https://auth.example.com

# OIDC domain name (used to resolve auth.example.com to host gateway internally)
OIDC_DOMAIN=auth.example.com

# Client ID created in PocketID for the NetBird dashboard/management
OIDC_CLIENT_ID=netbird

# Client Secret created in PocketID (leave blank if public client)
OIDC_CLIENT_SECRET=

# ==========================================
# NetBird App Reverse Proxy
# ==========================================

# Setup Token generated when creating Proxy Cluster in NetBird Dashboard
NB_PROXY_TOKEN=your_netbird_proxy_cluster_token_here


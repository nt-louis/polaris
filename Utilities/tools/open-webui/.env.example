# Open WebUI Settings
WEBUI_SECRET_KEY=
WEBUI_NAME=Polaris AI
ENABLE_OLLAMA=true
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Public URL and OIDC settings
WEBUI_URL=https://openwebui.example.com
CORS_ALLOW_ORIGIN=https://openwebui.example.com
OAUTH_PROVIDER_NAME=PocketID
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=your_openwebui_oidc_client_secret_here
OPENID_PROVIDER_URL=https://auth.example.com/.well-known/openid-configuration
OAUTH_SESSION_TOKEN_ENCRYPTION_KEY=your_openwebui_oauth_session_key_here

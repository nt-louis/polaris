PENPOT_DB_USER=penpot
PENPOT_DB_PASSWORD=penpot_secure_password_here
PENPOT_DB_NAME=penpot
PENPOT_SECRET_KEY=generate_some_long_random_string_here
PENPOT_PUBLIC_URI=https://penpot.example.com

# SMTP Configuration
PENPOT_SMTP_DEFAULT_FROM=no-reply@example.com
PENPOT_SMTP_DEFAULT_REPLY_TO=no-reply@example.com
PENPOT_SMTP_HOST=smtp.example.com
PENPOT_SMTP_PORT=587
PENPOT_SMTP_USERNAME=smtp_username_here
PENPOT_SMTP_PASSWORD=smtp_password_here
PENPOT_SMTP_TLS=true
PENPOT_SMTP_SSL=false

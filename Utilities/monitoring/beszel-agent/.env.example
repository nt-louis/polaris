# Beszel Agent Configuration for VPS B
# Get this value from the Beszel Hub UI on VPS A (Add System -> Copy Key)
BESZEL_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5..."
BESZEL_HUB_URL="https://your-vps-a-tailscale-fqdn/beszel"
BESZEL_TOKEN="your_vps_b_token_here"

# Tailscale Host mapping (needed if container DNS fails to resolve MagicDNS)
BESZEL_HUB_HOST="your-vps-a-tailscale-fqdn"
BESZEL_HUB_IP="your-vps-a-tailscale-ip"

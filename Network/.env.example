# User/Group IDs (find with: id $(whoami))
PUID=1000
PGID=1000
TZ=America/New_York

# VPN Configuration (Gluetun)
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
SERVER_COUNTRIES=

# Tailscale Configuration
TS_AUTHKEY=
TS_HOSTNAME=dns-gateway
TAILNET_FQDN=dns-gateway.your-tailnet-name.ts.net

ADGUARD_DOMAIN=adguard.example.com

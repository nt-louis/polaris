# Global System Configurations
TZ=Etc/UTC
PUID=1000
PGID=1000
MEDIA_SHARE=/path/to/your/media/share

# Backup Configurations (Restic)
BACKUP_PASSWORD=your-secure-restic-repository-password-here
# Shuts down active container processes temporarily during database compression for consistency
STOP_DURING_BACKUP=false

# Restic Backup Repositories (via Rclone backends)
# Primary repository remote — each VPS auto-appends its identity (e.g. gdrive:backups/polaris/vps-a)
RCLONE_REMOTE=gdrive:backups/polaris
# Secondary repository remote — snapshots are copied here via 'restic copy'
RCLONE_REMOTE_SECONDARY=

# Retention Policy (how many snapshots to keep per tag)
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# Nextcloud Cloud Storage (Rclone Crypt)
# Rclone Base Remote (e.g. Google Drive, OneDrive, S3, WebDAV)
RCLONE_CONFIG_NEXTCLOUD_BASE_TYPE=
RCLONE_CONFIG_NEXTCLOUD_BASE_CLIENT_ID=
RCLONE_CONFIG_NEXTCLOUD_BASE_CLIENT_SECRET=
RCLONE_CONFIG_NEXTCLOUD_BASE_TOKEN=
RCLONE_CONFIG_NEXTCLOUD_BASE_URL=
RCLONE_CONFIG_NEXTCLOUD_BASE_VENDOR=
RCLONE_CONFIG_NEXTCLOUD_BASE_USER=
RCLONE_CONFIG_NEXTCLOUD_BASE_PASS=

# Rclone Crypt Remote (Wraps base remote)
RCLONE_CONFIG_NEXTCLOUD_CRYPT_TYPE=crypt
RCLONE_CONFIG_NEXTCLOUD_CRYPT_REMOTE=nextcloud_base:nextcloud-data
RCLONE_CONFIG_NEXTCLOUD_CRYPT_FILENAME_ENCRYPTION=standard
RCLONE_CONFIG_NEXTCLOUD_CRYPT_DIRECTORY_NAME_ENCRYPTION=true
RCLONE_CONFIG_NEXTCLOUD_CRYPT_PASSWORD=
RCLONE_CONFIG_NEXTCLOUD_CRYPT_PASSWORD2=


